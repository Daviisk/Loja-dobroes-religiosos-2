NODE_ENV=development
PORT=3000
APP_URL=http://localhost:3000
MERCADO_PAGO_MODE=disabled
MERCADO_PAGO_ACCESS_TOKEN=
MERCADO_PAGO_PUBLIC_KEY=
MERCADO_PAGO_SELLER_ID=
MERCADO_PAGO_APPLICATION_ID=
# Chave secreta da configuração de Webhooks. Para CardForm/Checkout Transparente,
# habilite o evento Pagamentos (payment) apontando para APP_URL/api/webhooks/mercadopago.
WEBHOOK_SECRET=
DATABASE_PATH=backend/data/shop.sqlite

# Use homologation para testes e production somente após homologar.
CORREIOS_MODE=disabled
CORREIOS_USER=
CORREIOS_API_PASSWORD=
CORREIOS_POSTING_CARD=
# Códigos PAC/SEDEX autorizados no seu contrato (não são universais).
CORREIOS_PAC_CODE=
CORREIOS_SEDEX_CODE=
SHIPPING_ORIGIN_CEP=
# Peso real por unidade e embalagem vazia, em gramas.
SHIPPING_UNIT_WEIGHT_G=60
SHIPPING_PACKAGE_WEIGHT_G=
# Embalagem com unidades empilhadas: medidas em centímetros.
SHIPPING_LENGTH_CM=
SHIPPING_WIDTH_CM=
SHIPPING_BASE_HEIGHT_CM=
SHIPPING_UNIT_HEIGHT_CM=

# SuperFrete: gere o token de integração na sua conta e ative com
# SHIPPING_PROVIDER=superfrete. O token fica somente no servidor.
# SHIPPING_PROVIDER=superfrete
SUPERFRETE_TOKEN=
# IDs de modalidades separados por vírgula. O padrão consulta 1,2,17.
SUPERFRETE_SERVICES=1,2,17
# Em produção, configure apenas o endereço real do proxy confiável.
# TRUST_PROXY=loopback
