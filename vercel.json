{
  "functions": {
    "api/index.js": {
      "maxDuration": 15
    }
  },
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api?path=:path*"
    },
    {
      "source": "/js/cart.js",
      "destination": "/api?path=js/cart.js"
    },
    {
      "source": "/sucesso",
      "destination": "/api?path=sucesso"
    },
    {
      "source": "/sucesso.html",
      "destination": "/api?path=sucesso.html"
    },
    {
      "source": "/",
      "destination": "/frontend/index.html"
    },
    {
      "source": "/:path*",
      "destination": "/frontend/:path*"
    }
  ]
}
